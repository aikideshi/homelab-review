# ---------- Docker Registry ----------
  registry:
    image: registry:2
    container_name: registry
    restart: unless-stopped
    volumes:
      - registry-data:/var/lib/registry
    environment:
      REGISTRY_STORAGE_DELETE_ENABLED: "true"
    networks:
      - core_proxy

volumes:
  registry-data:

[global]
   workgroup = WORKGROUP
   server string = Homelab Samba (%h)
   security = user
   map to guest = bad user
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file

[{{ samba_share_name }}]
   comment = Homelab Storage
   path = {{ samba_share_path }}
   browseable = yes
   read only = no
   guest ok = no
   valid users = homerong
   create mask = 0664
   directory mask = 0775
   force user = homerong
   force group = homerong

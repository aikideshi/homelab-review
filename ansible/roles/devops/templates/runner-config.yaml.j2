log:
  level: info

runner:
  name: devops-101-trixie
  capacity: 1
  labels:
    - "docker:docker://node:22-trixie"
    - "ubuntu-latest:docker://node:22-trixie"
    - "ubuntu-24.04:docker://node:22-trixie"
    - "ubuntu-22.04:docker://node:22-trixie"
    - "ansible:docker://node:22-trixie"

container:
  network: bridge
  privileged: true
  options: --add-host=host.docker.internal:host-gateway
  valid_volumes:
    - /var/run/docker.sock

host:
  workdir_parent: /data

server:
  connections:
    forgejo:
      url: http://host.docker.internal:3000
      uuid: {{ FORGEJO_RUNNER_UUID }}
      token: {{ FORGEJO_RUNNER_TOKEN }}
